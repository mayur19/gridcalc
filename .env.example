# gridcalc local configuration. ./run.sh copies this to .env and replaces the secret.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4107
WEB_PORT=5107
APP_ORIGIN=http://localhost:5107

# Native local PostgreSQL over the Unix socket in /tmp as the current OS user (no password).
DATABASE_URL=postgres:///gridcalc_dev?host=/tmp
TEST_DATABASE_URL=postgres:///gridcalc_test?host=/tmp
DB_POOL_MAX=10

# HMAC key for session ids. run.sh generates a random value on first setup.
SESSION_SECRET=replace-me-with-a-long-random-local-only-value
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# false | hop count (e.g. 1 behind one nginx) | comma-separated proxy IPs/CIDRs. Never "true".
TRUST_PROXY=false

LOG_LEVEL=info
# Failed logins per email before progressive backoff, and the shared window (seconds).
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SEC=900
LOGIN_IP_RATE_LIMIT_MAX=50
REGISTER_RATE_LIMIT_MAX=5

ENGINE_CACHE_SIZE=16
MAX_CELLS_PER_WORKBOOK=200000
BODY_LIMIT_BYTES=4194304
